# 服务配置
PORT=3000
UPLOAD_DIR=./uploads

# 开发/演示模式
# true: 使用本地 Mock 识别，无需外部 API Key
# false: 按下方已配置的真实 AI Provider 调用
MOCK_AI=true

# 火山方舟视觉模型（OpenAI 兼容接口）
VOLCANO_API_KEY=
VOLCANO_MODEL_ENDPOINT=
VOLCANO_MODEL_ID=doubao-vision-lite-32k-250115

# 也兼容火山控制台复制出来的简写字段：
# API_KEY=
# Model ID=

# 阿里云视觉智能（当前为占位适配，需补实际 SDK 调用）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# 百度 AI 开放平台（当前为占位适配，需补实际 token 与接口调用）
BAIDU_APP_ID=
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# 高德天气 Web 服务 API
# 城市编码 adcode 可查高德城市编码表；110101 为北京市东城区
AMAP_KEY=
AMAP_CITY=110101
